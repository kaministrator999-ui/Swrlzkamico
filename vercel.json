{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "dev": false
    }
  },
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{.transport/**,SWRLZ_NEW_SERVER_GITHUB_READY.zip}"
    }
  },
  "rewrites": [
    {
      "source": "/live/:path*",
      "destination": "/api/chat/live/:path*"
    }
  ]
}
