{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "dev": false
    }
  },
  "ignoreCommand": "git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- DEPLOY_TRIGGER_SERVER_2.2.2.md",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{.transport/**,SWRLZ_NEW_SERVER_GITHUB_READY.zip}"
    }
  }
}
