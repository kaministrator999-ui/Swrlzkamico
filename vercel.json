{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "git": {
    "deploymentEnabled": false
  },
  "routes": [
    {
      "src": "/api/chat/client-debug/?$",
      "methods": ["GET", "POST"],
      "dest": "/api/chat.py"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{.transport/**,swrlz-core/**,SWRLZ_NEW_SERVER_GITHUB_READY.zip}"
    }
  }
}
