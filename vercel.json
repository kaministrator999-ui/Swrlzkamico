{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "git": {
    "deploymentEnabled": false
  },
  "github": {
    "enabled": false
  },
  "routes": [
    {
      "src": "/api/chat/client-debug/?$",
      "methods": [
        "GET",
        "POST"
      ],
      "dest": "/api/chat.py",
      "transforms": [
        {
          "type": "request.query",
          "op": "set",
          "target": {
            "key": "__swrlz_client_debug"
          },
          "args": "1"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{.transport/**,swrlz-core/**,SWRLZ_NEW_SERVER_GITHUB_READY.zip}",
      "includeFiles": "{swyrlz/**,native/**}"
    }
  }
}
