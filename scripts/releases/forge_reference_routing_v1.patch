+# A user may delegate the method after explicitly requesting native construction.
+# A standalone how-to, or a separate question in the same turn, stays explanatory.
+_DIRECT_CONSTRUCTION = re.compile(
+    r"^(?:(?:using|with|from|based on)\b[^,.!?;]*,\s*)?"
+    r"(?:(?:please|(?:can|could|would) you)\s+)*(?:create|make|build)\s+", re.I)
+_DELEGATED_METHOD = re.compile(r"\b(?:you\s+(?:can\s+|may\s+)?)?(?:choose|decide)\s+how\s+to\b", re.I)
@@ -117 +123,4 @@
-    if _EXPLAIN.search(text):
+    first_clause = re.split(r"[.!?;]", text, maxsplit=1)[0]
+    explicit_construction = _DIRECT_CONSTRUCTION.match(first_clause) and _NATIVE.search(first_clause)
+    explanatory_text = _DELEGATED_METHOD.sub("choose the method to", text) if explicit_construction else text
+    if _EXPLAIN.search(explanatory_text):
