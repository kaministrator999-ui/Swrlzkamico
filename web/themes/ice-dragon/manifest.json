{
  "id": "swrlz-ice-dragon",
  "name": "SWRLZ Ice Dragon",
  "version": "1.0.1",
  "targetRepository": "kaministrator999-ui/Swrlzkamico",
  "targetFiles": ["web/chat.html", "web/chat_enhancements.css", "web/chat_account.js"],
  "entryCss": "ice-dragon-theme.css",
  "entryJs": "ice-dragon-theme.js",
  "assets": ["assets/ice-dragon-sigil.svg", "assets/ice-shards.svg"],
  "activation": "body[data-swrlz-theme=\"ice-dragon\"]",
  "defaultEnabled": false,
  "storageKey": "swrlz.chat.theme",
  "selector": "#swrlzThemeSelect",
  "features": [
    "opt-in Default / Ice Dragon theme selector",
    "localStorage theme persistence",
    "ice/frost palette",
    "dragon sigil ambient watermark",
    "bright mobile sidebar while background is dimmed",
    "frosted assistant and user bubbles",
    "enhancement toolbar/evidence/modal styling",
    "composer and send-button styling",
    "mobile responsive treatment",
    "prefers-reduced-motion support"
  ]
}
