    "/chat": {
      "source": "web/chat.html",
      "styles": [
        "web/chat_boot_guard.css",
        "web/chat_enhancements.css",
        "web/themes/ice-dragon/ice-dragon-theme.css",
        "web/themes/ice-dragon/ice-dragon-art-v2.css",
        "web/chat_mobile_viewport_fix.css",
        "web/chat_code_artifacts.css"
      ],
      "scripts": [
        "web/chat_boot_guard.js",
        "web/chat_admin_session.js",
        "web/chat_enhancements.js",
        "web/chat_google_server_config.js",
        "web/chat_stream_focus.js",
        "web/chat_version.js",
        "web/themes/ice-dragon/ice-dragon-theme-v3.2.js",
        "web/themes/ice-dragon/ice-dragon-art-loader-v14.js",
        "web/chat_code_artifacts.js",
        "web/chat_stream_incremental.js",
        "web/chat_user_time_context.js",
        "web/chat_context_canonical.js",
        "web/chat_background_resume.js",
        "web/chat_context_camera.js",
