{
  "version": 2,
  "mode": "runtime-source-of-truth",
  "routes": {
    "/": {"source": "runtime_pages/index.html"},
    "/chat": {
      "source": "web/chat.html",
      "styles": ["web/chat_enhancements.css"],
      "scripts": ["web/chat_admin_session.js", "web/chat_enhancements.js", "web/chat_stream_focus.js", "web/chat_version.js"]
    },
    "/server": {"source": "web/server.html"},
    "/lalm": {"source": "web/lalm.html"},
    "/admin": {"source": "web/admin.html"},
    "/live": {"source": "runtime_pages/index.html"}
  },
  "assetRoots": ["web", "runtime_pages"],
  "notes": "The manifest is durable runtime configuration. The stable server only interprets route/source/style/script metadata; all page-owned code remains on runtime. Add, change, or remove routes and assets here without a Vercel deployment."
}
