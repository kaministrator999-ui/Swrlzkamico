# Required. Use a private random value of at least 16 characters.
SWRLZ_WEB_CHAT_TOKEN=replace-with-a-long-random-value

# Optional until a reachable SWRLZ SERVER is available. If omitted, the page
# remains in truthful R39 status-only mode and does not synthesize replies.
SWRLZ_CHAT_UPSTREAM_URL=https://your-proof-bound-server-gateway.example
SWRLZ_CHAT_UPSTREAM_NODE_ID=registered-client-node-id
SWRLZ_CHAT_UPSTREAM_DEVICE_PROOF=registered-client-device-proof

# Optional outer HTTPS gateway authorization. Never expose this in browser code.
SWRLZ_CHAT_UPSTREAM_BEARER=

# Socket-idle bound. The native SERVER emits heartbeats below its own idle limit.
SWRLZ_CHAT_UPSTREAM_IDLE_TIMEOUT_SECONDS=45
