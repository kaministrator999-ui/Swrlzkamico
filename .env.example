# Existing unified SERVER environment
SWRLZ_ADMIN_TOKEN=CHANGE_ME
SWRLZ_R39_URL=

# Web chat access boundary. Keep this separate from SWRLZ_ADMIN_TOKEN.
SWRLZ_WEB_CHAT_TOKEN=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET

# §wyrlz user account identity/data boundary.
# GOOGLE_OAUTH_CLIENT_ID is the public OAuth client ID used by Google Identity Services.
GOOGLE_OAUTH_CLIENT_ID=
# Long random server-only signing secret for the HttpOnly session cookie.
SWRLZ_AUTH_SECRET=
# Durable user/chat storage. Vercel KV/Upstash REST compatible.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Proof-bound SWRLZ SERVER bridge. Leave blank for truthful R39 status-only mode.
# A private LAN address is not reachable from Vercel without an external gateway.
SWRLZ_CHAT_UPSTREAM_URL=
SWRLZ_CHAT_UPSTREAM_NODE_ID=
SWRLZ_CHAT_UPSTREAM_DEVICE_PROOF=
SWRLZ_CHAT_UPSTREAM_BEARER=
SWRLZ_CHAT_UPSTREAM_IDLE_TIMEOUT_SECONDS=45

# Optional loader source overrides. The current backend also consumes Vercel's Git
# metadata automatically when these are not supplied.
SWRLZ_GITHUB_REPO_OWNER=kaministrator999-ui
SWRLZ_GITHUB_REPO_SLUG=Swrlzkamico
SWRLZ_GITHUB_REF=
